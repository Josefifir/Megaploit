# =============================================================================
#  Megaploit — .dockerignore
#  Keeps the build context lean and keeps secrets / host cruft out of the image.
# =============================================================================

# Version control + CI
.git/
.gitignore
.gitmodules
.github/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Secrets / credentials — NEVER bake into an image.
# secret.key and TLS material are generated/mounted at runtime via /data.
secret.key
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Operator-side collected data (persisted via the /data volume, not the image)
loot/
!loot/.gitkeep

# Toolbox clones (large; rebuilt on demand by the toolbox at runtime)
tools/*/
!tools/tools.json

# Face-detection saved model (11 MB, not used by the server console)
saved_model/

# MkDocs build output
site/

# Test suite (not needed at runtime)
tests/

# Editor / OS cruft
.idea/
.vscode/
.qodo/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Docker files themselves (avoid self-referential COPY confusion)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Build / test artefacts
.coverage
htmlcov/
.pytest_cache/
agent_compiled/

# Docs source (not needed at runtime; remove to serve mkdocs inside the container)
docs/
mkdocs.yml

# Misc project files
*.md
LICENSE
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
